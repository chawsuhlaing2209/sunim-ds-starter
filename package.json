{
  "name": "@sunim/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Sunim Design System \u2014 course starter (Day 2)",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chawsuhlaing2209/sunim-ds-starter.git"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts/*": "./dist/fonts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:tokens": "style-dictionary build --config style-dictionary.config.js",
    "build": "npm run build:tokens && vite build && tsc -p tsconfig.build.json && node scripts/bundle-css.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "security-check": "node scripts/security-check.mjs",
    "release-review": "node scripts/release-review.mjs",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish.mjs",
    "docs:install": "npm --prefix docs install --no-audit --no-fund",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm run build:tokens && npm --prefix docs run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.9",
    "style-dictionary": "^5.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
