{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    /* The intent files are JSON so a Node gate can read them without a
       compiler; this is what lets the stories import the same file. */
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", ".storybook"]
}
