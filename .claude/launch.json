{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "storybook",
        "--",
        "--no-open"
      ],
      "port": 6006
    },
    {
      "name": "reference",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "docs",
        "run",
        "dev",
        "--",
        "--host",
        "127.0.0.1"
      ],
      "port": 4321,
      "autoPort": true
    }
  ]
}
