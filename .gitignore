node_modules/

# Anchored to the repo root on purpose. An unanchored `build/` also matches
# .claude/skills/build/, which silently excluded the build skill from version
# control — the same class of loss that took src/ with it.
/build/
/dist/
/storybook-static/

# The knowledge skill that ships inside the package. Generated from the intent
# contract by scripts/generate-skill.mjs — same rule as /dist/ and build/tokens/:
# an edit here lasts until the next build, and the component it disagreed with is
# still right. Anchored, so .claude/skills/ is untouched.
/skill/

.DS_Store
*.log

# Secrets. Nothing here should ever reach a public repo — and this repo is
# public. Deploy credentials for the staging host will land in one of these.
.env
.env.*
!.env.example
*.pem
*.key
.npmrc
.netrc
secrets.json
*.local.json
.vercel

# npm pack output — a build artefact, never committed
*.tgz
