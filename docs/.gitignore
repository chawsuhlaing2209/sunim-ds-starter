# Astro's own
dist/
.astro/
node_modules/

# Generated from the meta contract by scripts/generate-docs.mjs.
# Never edit a file in here by hand — the same rule as build/tokens/.
# It lasts until the next build, and the intent it disagreed with is still wrong.
src/content/docs/components/*
!src/content/docs/components/.gitkeep
src/content/docs/start/versioning.md
src/content/docs/start/tokens.md
src/styles/tokens.generated.css
